{
  "name": "ni-han-bao-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "backfill": "node dist/backfill.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "placeholders": "tsx src/placeholders.ts",
    "icons": "tsx src/icons.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
